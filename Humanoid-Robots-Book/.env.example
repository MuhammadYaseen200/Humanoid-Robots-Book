# ── BACKEND API ──────────────────────────────────────────────────────────────
# OpenAI API (required for rag-ingest skill embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Qdrant Vector Database (required for rag-ingest skill)
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# Anthropic API (optional - for Claude Code CLI skills)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── FRONTEND (VITE) ───────────────────────────────────────────────────────────
# Backend API URL (REQUIRED)
# Development: http://localhost:8000
# Production: https://your-api-domain.com
VITE_API_URL=http://localhost:8000

# Application Environment (REQUIRED)
# Options: development, production
VITE_ENV=development

# Application Metadata
VITE_APP_NAME=Physical AI & Humanoid Robotics Textbook
VITE_APP_VERSION=1.0.0

# Feature Flags (Optional)
VITE_ENABLE_PROFILE_MANAGEMENT=true
VITE_ENABLE_PASSWORD_RESET=false

# Analytics (Optional)
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX
